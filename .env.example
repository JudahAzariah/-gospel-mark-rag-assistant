# Choose either "openai" or "anthropic".
LLM_PROVIDER=openai

# For OpenAI:
OPENAI_API_KEY=put_your_key_here
OPENAI_MODEL=gpt-4o-mini

# Or use Anthropic by setting LLM_PROVIDER=anthropic and filling this in:
ANTHROPIC_API_KEY=put_your_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Refuse automatically if the best retrieved chunk score is below this value.
# Tune after inspecting your real retrieval scores.
RAG_MIN_SIMILARITY=0.32

# Optional; default embedding model is sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
